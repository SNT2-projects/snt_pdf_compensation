    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    declaration_reference, nom_du_client, type_de_promo, ref_article, designation,\n    to_char(date_debut, 'YYYY-MM-DD')               AS date_debut_txt,\n    to_char(date_fin,   'YYYY-MM-DD')               AS date_fin_txt,\n    quantite, compensation_ht, total, ref_avoir,\n    is_retard, is_doublon, doublon_de_reference,\n    to_char(doublon_de_date,  'DD/MM/YYYY')         AS doublon_de_date_txt,\n    to_char(date_declaration, 'DD/MM/YYYY HH24:MI') AS date_declaration_txt\nFROM public.declarations_export\nWHERE archived_at IS NULL\n  AND periode = $1::date\nORDER BY date_declaration, id;",
        "options": {
          "queryReplacement": "={{ $('Loop Periods').item.json.periode }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1056,
        224
      ],
      "id": "d9c39a38-8ce4-4794-a202-43aad0118a3c",
      "name": "Get Lines For Period",
      "credentials": {
        "postgres": {
          "id": "S4K1CxlHRmNEsUuM",
          "name": "APP Metier Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().filter(i => i.json && typeof i.json.is_doublon === 'boolean')\n.map(i => {\n  const r = i.json;\n\n  // Une ligne peut cumuler les deux anomalies.\n  const statut = [\n    r.is_retard  ? 'RETARD'  : null,\n    r.is_doublon ? 'DOUBLON' : null,\n  ].filter(Boolean).join(' + ');\n\n  const doublonDe = r.is_doublon\n    ? [r.doublon_de_reference, r.doublon_de_date_txt].filter(Boolean).join(' du ')\n    : '';\n\n  // Postgres renvoie les NUMERIC sous forme de chaine : on reconvertit pour que\n  // Google Sheets stocke un nombre et non du texte.\n  const num = (v) => (v === null || v === undefined || v === '') ? 0 : Number(v);\n\n  return {\n    json: {\n      'REF DECLARATION': r.declaration_reference || '',\n      'NOM DU CLIENT': r.nom_du_client || '',\n      'TYPE DE PROMO': r.type_de_promo || '',\n      'REF ARTICLE': r.ref_article || '',\n      'DESIGNATION': r.designation || '',\n      'DATE DEBUT': r.date_debut_txt || '',\n      'DATE FIN': r.date_fin_txt || '',\n      'QUANTITE': num(r.quantite),\n      'COMPENSATION HT': num(r.compensation_ht),\n      'TOTAL': num(r.total),\n      'REF AVOIR': r.ref_avoir || '',\n      'STATUT': statut,\n      'DOUBLON DE': doublonDe,\n      'DATE DECLARATION': r.date_declaration_txt || '',\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
