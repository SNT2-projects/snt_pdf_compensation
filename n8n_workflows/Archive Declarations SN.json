    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    declaration_reference, nom_du_client, type_de_promo, ref_article, designation,\n    ean, numero_serie,\n    to_char(date_debut, 'YYYY-MM-DD')               AS date_debut_txt,\n    to_char(date_fin,   'YYYY-MM-DD')               AS date_fin_txt,\n    quantite, compensation_ht, total,\n    is_retard, is_doublon, doublon_de_reference, doublon_de_client,\n    to_char(doublon_de_date,  'DD/MM/YYYY')         AS doublon_de_date_txt,\n    to_char(date_declaration, 'DD/MM/YYYY HH24:MI') AS date_declaration_txt\nFROM public.declarations_sn_export\nWHERE archived_at IS NULL\n  AND periode = $1::date\nORDER BY date_declaration, id;",
        "options": {
          "queryReplacement": "={{ [$('Loop Periods').item.json.periode] }}"
        }
      },
      "id": "951ef5d4-279d-43bd-8690-6c3493745191",
      "name": "Get Lines For Period",
